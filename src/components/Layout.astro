---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Lou Tracey Yoga',
  description = 'Yoga with Lou Tracey. Book a class, and check back soon for events and retreats.',
} = Astro.props as Props;
const ogImage = new URL('/img/lou-illustration-1600.png', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#EDE9FB" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/png" href="/img/favicon.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Patrick+Hand+SC&family=Nunito:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
    :root {
      --ink: #2B2752;
      --ink-soft: #55507F;
      --lavender: #EDE9FB;
      --lilac: #B9B0EC;
      --purple: #7466C8;
      --gold: #C9A24A;
      --cream: #FFFEE8;
      --paper: #FBFAFF;
      --radius: 999px;
      --max: 1080px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

    body {
      margin: 0;
      font-family: "Nunito", system-ui, sans-serif;
      font-size: 1.0625rem;
      line-height: 1.6;
      color: var(--ink);
      background: var(--paper);
      -webkit-font-smoothing: antialiased;
    }

    img { max-width: 100%; height: auto; display: block; }
    a { color: inherit; }

    .hand {
      font-family: "Patrick Hand SC", "Comic Sans MS", cursive;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: lowercase;
    }

    .wrap { max-width: var(--max); margin: 0 auto; padding: 0 20px; }

    /* Header */
    .site-header {
      position: sticky; top: 0; z-index: 10;
      background: color-mix(in srgb, var(--paper) 85%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid color-mix(in srgb, var(--lilac) 40%, transparent);
    }
    .site-header .wrap {
      display: flex; align-items: center; justify-content: space-between;
      height: 64px; gap: 16px;
    }
    .wordmark { font-size: 1.5rem; text-decoration: none; white-space: nowrap; }

    /* Buttons */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: .5em;
      font-family: "Patrick Hand SC", cursive;
      font-size: 1.35rem; letter-spacing: .06em; text-transform: lowercase;
      text-decoration: none;
      padding: .55em 1.5em;
      border-radius: var(--radius);
      border: 2px solid var(--ink);
      background: var(--cream);
      color: var(--ink);
      box-shadow: 3px 3px 0 var(--ink);
      transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }
    .btn:hover { transform: translate(-1px, -1px); box-shadow: 5px 5px 0 var(--ink); background: #fff; }
    .btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--ink); }
    .btn:focus-visible { outline: 3px solid var(--purple); outline-offset: 3px; }
    .btn--small { font-size: 1.1rem; padding: .35em 1.1em; box-shadow: 2px 2px 0 var(--ink); }

    /* Hero */
    .hero { position: relative; overflow: hidden; padding: 48px 0 80px; }
    .hero .wrap {
      display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 40px;
    }

    .art { position: relative; aspect-ratio: 1; max-width: 520px; width: 100%; justify-self: center; }
    /* Watercolour wash, drawn in CSS so there's no heavy image to download */
    .wash {
      position: absolute; inset: 2%;
      border-radius: 46% 54% 58% 42% / 52% 44% 56% 48%;
      background:
        radial-gradient(circle at 38% 40%, rgba(116,102,200,.55), transparent 55%),
        radial-gradient(circle at 65% 62%, rgba(150,138,220,.55), transparent 60%),
        radial-gradient(circle at 50% 50%, rgba(185,176,236,.75), rgba(237,233,251,0) 72%);
      filter: blur(6px);
      animation: drift 18s ease-in-out infinite alternate;
    }
    .ring { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
    .art img { position: relative; width: 100%; }
    @keyframes drift {
      from { transform: rotate(0deg) scale(1); }
      to   { transform: rotate(14deg) scale(1.04); }
    }
    @media (prefers-reduced-motion: reduce) { .wash { animation: none; } }

    .hero h1 {
      font-size: clamp(3rem, 7vw, 5.25rem);
      line-height: .95;
      margin: 0 0 .3em;
    }
    .hero .lede { font-size: 1.2rem; color: var(--ink-soft); max-width: 30ch; margin: 0 0 1.6em; }
    .hero .note { font-size: .95rem; color: var(--ink-soft); margin-top: 1.25em; }

    /* Sections */
    section { padding: 72px 0; }
    .section-title { font-size: clamp(2rem, 4vw, 2.75rem); margin: 0 0 .2em; text-align: center; }
    .section-sub { text-align: center; color: var(--ink-soft); margin: 0 auto 40px; max-width: 46ch; }

    .offerings { background: var(--lavender); }
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .card {
      background: var(--paper);
      border: 2px solid var(--ink);
      border-radius: 22px;
      padding: 28px 24px;
      box-shadow: 4px 4px 0 var(--lilac);
    }
    .card h3 { font-size: 1.8rem; margin: 0 0 .25em; }
    .card p { margin: 0 0 1em; color: var(--ink-soft); }
    .tag {
      display: inline-block; font-size: .8rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
      padding: .25em .75em; border-radius: var(--radius);
      background: var(--cream); border: 1px solid var(--gold); color: #7a5f1f;
    }
    .tag--live { background: #E5F5EA; border-color: #5BA672; color: #2F6B42; }
    .card a.inline { font-weight: 700; color: var(--purple); }

    .cta { text-align: center; }
    .cta p { color: var(--ink-soft); margin: 0 auto 28px; max-width: 40ch; }

    footer {
      border-top: 1px solid color-mix(in srgb, var(--lilac) 50%, transparent);
      padding: 28px 0 40px; font-size: .9rem; color: var(--ink-soft);
    }
    footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }

    .ig {
      display: inline-flex; align-items: center; gap: .4em;
      font-weight: 700; color: var(--purple); text-decoration: none;
    }
    .ig:hover { text-decoration: underline; }
    .ig:focus-visible { outline: 3px solid var(--purple); outline-offset: 3px; border-radius: 4px; }
    .cta .follow { margin: 24px auto 0; }

    @media (max-width: 820px) {
      .hero { padding: 24px 0 56px; }
      .hero .wrap { grid-template-columns: 1fr; text-align: center; gap: 12px; }
      .art { max-width: 340px; order: -1; }
      .hero .lede { margin-left: auto; margin-right: auto; }
      .cards { grid-template-columns: 1fr; }
      section { padding: 56px 0; }
    }
    @media (max-width: 420px) {
      .site-header .btn--small { font-size: 1rem; padding: .3em .9em; }
      .wordmark { font-size: 1.25rem; }
    }
</style>
